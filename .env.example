# Sovereign-Mind Environment Configuration
# Copy this file to .env and fill in the values

# ============================================================================
# Application Settings
# ============================================================================
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# Security Settings (Module A: The Vault)
# ============================================================================
# Argon2 parameters (increase for more security, but slower)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Storage paths
VAULT_STORAGE_PATH=./data/vault
AUDIT_LOG_PATH=./data/audit

# ============================================================================
# LLM Settings
# ============================================================================
# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Cloud LLM (OpenAI) - Optional, for cloud_secure mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

# Default mode
DEFAULT_MODE=local
DEFAULT_DEPTH=fast

# ============================================================================
# RAG Settings (Module C)
# ============================================================================
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=sovereign_mind_docs
EMBEDDING_MODEL=mxbai-embed-large

# Retrieval tuning
DENSE_TOP_K=25
SPARSE_TOP_K=25
RERANK_TOP_N=50
FINAL_TOP_K=5

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ============================================================================
# Privacy Settings (Module D)
# ============================================================================
# Detection threshold (0.0-1.0, higher = stricter)
PII_DETECTION_THRESHOLD=0.7
PII_LANGUAGES=["en"]
BLOCK_PII_ON_CLOUD=true

# ============================================================================
# Agent Settings (Module B)
# ============================================================================
MAX_RETRIEVAL_RETRIES=3
GRADER_RELEVANCE_THRESHOLD=0.7
MAX_PLANNING_STEPS=5

# ============================================================================
# Security Middleware
# ============================================================================
# Optional API key for production (leave empty to disable)
API_KEY=
# Rate limit per IP (e.g., "60/minute", "100/minute")
RATE_LIMIT=60/minute

# ============================================================================
# Chunking Strategy
# ============================================================================
# "fixed" (default) or "semantic"
CHUNKING_STRATEGY=fixed
